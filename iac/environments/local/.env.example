# Spire — Local Environment
# Copy to .env before running: cp .env.example .env

# ── Domínio local ──────────────────────────────────────────────────────────────
BASE_DOMAIN=spire.localhost

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=spire_dev_secret
POSTGRES_USER=spire
POSTGRES_DB=spire

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=spire
# Client ID registrado no realm para o Backstage
KEYCLOAK_CLIENT_ID=backstage
KEYCLOAK_CLIENT_SECRET=backstage-dev-secret

# ── Backstage ─────────────────────────────────────────────────────────────────
BACKSTAGE_BASE_URL=http://backstage.spire.localhost
AUTH_BACKEND_SECRET=a-very-long-local-dev-secret-32chars

# ── MinIO (substituto local do OCI Object Storage) ────────────────────────────
MINIO_ROOT_USER=spire
MINIO_ROOT_PASSWORD=spire_minio_dev
MINIO_BUCKET=spire-artifacts

# ── Kong ──────────────────────────────────────────────────────────────────────
KONG_PG_DATABASE=kong
