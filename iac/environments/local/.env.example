# Spire — Local Environment
# Copy to .env before running: cp .env.example .env
# After first run: fill VAULT_* vars with values from: make vault-token

# ── Domínio local ──────────────────────────────────────────────────────────────
BASE_DOMAIN=spire.localhost

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=spire_dev_secret
POSTGRES_USER=spire
POSTGRES_DB=spire

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=spire
KEYCLOAK_CLIENT_ID=backstage
KEYCLOAK_CLIENT_SECRET=backstage-dev-secret

# ── Backstage ─────────────────────────────────────────────────────────────────
BACKSTAGE_BASE_URL=https://backstage.spire.localhost
AUTH_BACKEND_SECRET=a-very-long-local-dev-secret-32chars

# ── SeaweedFS (object storage S3-compatible, Apache 2.0) ─────────────────────
SEAWEEDFS_BUCKET=spire-artifacts
SEAWEEDFS_ACCESS_KEY=spire-access-key
SEAWEEDFS_SECRET_KEY=spire-secret-key

# ── Vault ─────────────────────────────────────────────────────────────────────
# Client secret for the 'vault' OIDC client in Keycloak
VAULT_KEYCLOAK_CLIENT_SECRET=vault-dev-secret
# Filled automatically after first 'make up' — see: make vault-token
VAULT_ROOT_TOKEN=
VAULT_UNSEAL_KEY=
# AppRole credentials for Backstage → Vault integration
VAULT_BACKSTAGE_ROLE_ID=
VAULT_BACKSTAGE_SECRET_ID=

# ── Kong ──────────────────────────────────────────────────────────────────────
KONG_PG_DATABASE=kong
# Client secret for the 'kong' OIDC client in Keycloak (used by oidcify plugin)
KONG_KEYCLOAK_CLIENT_SECRET=kong-dev-secret

# ── Backstage pipeline token (EXP-006) ────────────────────────────────────────
# Injected by Kong request-transformer after OPA approves spire-registrar role.
# Static token — not for production. See ADR-002.
BACKSTAGE_PIPELINE_TOKEN=spire-pipeline-token-dev-insecure-do-not-use-in-prod

# ── GitHub integration ────────────────────────────────────────────────────────
# Required for catalog ingestion from GitHub. Scopes: read:org, read:repo
GITHUB_TOKEN=

# ── Governance plugin (EXP-008) ───────────────────────────────────────────────
# Internal Docker network URLs — no override needed unless customized
# APICURIO_URL=http://apicurio:8080
# KONG_ADMIN_URL=http://kong:8001
# MICROCKS_URL=http://microcks:8080
